<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<VBox prefHeight="1020.0" prefWidth="1527.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.wvicto.parcours.controller.ParcoursController">
    <children>
        <Label prefHeight="0.0" prefWidth="449.0" text="Application Parcours - Gestion des trajets GPX" />
      <MenuBar>
        <menus>
                <Menu text="Fichier">
                    <items>
                        <MenuItem onAction="#chargerTrajet" text="Charger un ou plusieurs fichiers GPX" />
                        <MenuItem onAction="#chargerDossier" text="Charger un dossier" />
                    </items>
                </Menu>
                <Menu text="Trajets">
                    <items>
                        <MenuItem onAction="#analyserPentes" text="Analyser les pentes" />
                        <MenuItem onAction="#ouvrirFiltre" text="Filtrer les trajets" />
                        <MenuItem onAction="#afficherTousTrajets" text="Tout afficher" />
                    </items>
                </Menu>
                <Menu text="Routes">
                    <items>
                        <MenuItem onAction="#genererRouteDepuisTrajet" text="Désigner comme route typique" />
                        <MenuItem onAction="#classifierParRoutes" text="Classifier par routes" />
                        <MenuItem text="Créer une route (clics sur la carte)..." onAction="#demarrerCreationRoute" />
						<MenuItem text="Terminer la route en cours" onAction="#terminerCreationRoute" />
						<MenuItem text="Annuler la création de route" onAction="#annulerCreationRoute" />
						<MenuItem text="Gérer les routes..." onAction="#gererRoutes" />
						<MenuItem text="Vue d'ensemble des routes..." onAction="#vueEnsembleRoutes" />
						<MenuItem text="Afficher des routes sur la carte..." onAction="#afficherRoutesSurCarte" />
						<MenuItem text="Analyser une route..." onAction="#analyserRoute" />
					</items>
                </Menu>
        </menus>
      </MenuBar>
      <SplitPane dividerPositions="0.2" VBox.vgrow="ALWAYS">
        <items>
            <ListView fx:id="listeTrajets" />
            <SplitPane orientation="VERTICAL" dividerPositions="0.7848360655737705">
                <items>
                    <fx:include source="CartePoints.fxml" fx:id="carte" />
                    <VBox spacing="5">
                        <children>
                            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 5;">
                                <Label text="Afficher :" />
                                <RadioButton fx:id="radioVitesse" text="Vitesse" selected="true" onAction="#changerModeGraphique">
                                    <toggleGroup>
                                        <ToggleGroup fx:id="groupeModeGraphique" />
                                    </toggleGroup>
                                </RadioButton>
                                <RadioButton fx:id="radioPente" text="Pente" toggleGroup="$groupeModeGraphique" onAction="#changerModeGraphique" />
                            </HBox>
                            <StackPane stylesheets="@graphique.css" VBox.vgrow="ALWAYS">
                                <children>
                                    <LineChart fx:id="graphiqueAltitude" legendVisible="false" styleClass="graphique-altitude">
                                        <xAxis>
                                            <NumberAxis side="BOTTOM" label="Distance (km)" />
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis side="LEFT" label="Altitude (m)" />
                                        </yAxis>
                                    </LineChart>
                                    <LineChart fx:id="graphiqueVitesse" legendVisible="false" styleClass="graphique-superpose">
                                        <xAxis>
                                            <NumberAxis side="BOTTOM" tickLabelsVisible="false" tickMarkVisible="false" />
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis side="RIGHT" label="Vitesse (km/h)" />
                                        </yAxis>
                                    </LineChart>
                                </children>
                            </StackPane>
                        </children>
                    </VBox>
                </items>
            </SplitPane>
        </items>
      </SplitPane>
		<HBox prefHeight="26.0" prefWidth="1527.0" spacing="10">
		    <Button onAction="#chargerTrajet" text="Charger un ou plusieurs fichiers GPX" />
    		<Button onAction="#chargerDossier" text="Charger un dossier" />
    		<Button onAction="#analyserPentes" text="Analyser les pentes" />
    		<Button onAction="#lisserTrajetSelectionne" text="Lisser ce trajet (barycentre)" />
    		<Button onAction="#ouvrirFiltre" text="Filtrer les trajets" />
    		<Button onAction="#afficherTousTrajets" text="Tout afficher" />
    		<Button onAction="#genererRouteDepuisTrajet" text="Désigner comme route typique" />
    		<Button onAction="#classifierParRoutes" text="Classifier par routes" />
		</HBox>
    </children>
</VBox>